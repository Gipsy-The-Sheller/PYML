+/* ===================== vecLnL: SIMD likelihood path =======================
+   An optional second implementation of the pruning algorithm, selected by
+   `vecLnL = 1` in the control file.  The scalar ConditionalPNode() below is
+   left completely untouched, so the two can be A/B compared inside one binary
+   and the results checked against each other.
+
+   Why the memory layout changes.  The scalar path stores a node's conditional
+   probabilities pattern-major, conP[h*ncode + j], and its inner loop is
+
+       for (j) { t = 0; for (k) t += PMat[j*n+k] * child[h*n+k]; parent[h*n+j] *= t; }
+
+   a length-`ncode` dot product with the reduction in a scalar accumulator.
+   There is no axis there a compiler can vectorize against.  Here each node
+   block is stored state-major instead, vecConP[j*npatt + h], so that the
+   pattern axis -- the only long axis in the problem -- becomes contiguous.
+
+   How the kernel is written matters more than the layout.  The obvious
+   translation is ncode*ncode AXPYs (pyml_vec_muladd_f64), one per (j,k), and
+   that is in fact what pyml/cpp/likelihood.hpp does.  Measured against PAML
+   it comes out *slower* than the scalar code: each AXPY streams the whole
+   child block and rewrites the whole accumulator, so the memory traffic is
+   ncode times higher, and for ncode = 4 that costs more than the 4-wide SIMD
+   wins back.  pyml_vec_pmat_mul_f64() instead walks the pattern axis once,
+   loads each tile of the child into registers, reduces over k there, and
+   stores the parent tile once -- the same traffic as the scalar loop.
+
+   Tips are not stored at all.  A tip's contribution to its parent,
+
+       sum_k PMat[j][k] * L_tip[k][h]   with  L_tip[k][h] = delta(k, z[h]),
+
+   depends only on the data -- never on branch lengths or model parameters --
+   so it is folded once per locus into a state-major 0/1 indicator block
+   (vecTipInd[]).  Clean and ambiguous sites are handled uniformly: an
+   ambiguous code simply lights up more than one state in its column, which
+   reproduces PAML's unweighted sum over CharaMap[] (see the !com.cleandata
+   branch of ConditionalPNode).  Avoiding a per-pattern gather of
+   PMat[j*n + z[h]] is worth roughly a factor of two on the tip branches, and
+   tips are half the branches of a tree.
+
+   Deliberately NOT done here: node scaling.  com.NnodeScale is only ever
+   assigned inside a comment block in this file, so the guard at the end of
+   ConditionalPNode() can never fire under mcmctree.
+   ========================================================================= */
+
+static double *vecTipInd = NULL;      /* [tip][k*npatt + h], one locus at a time */
+static size_t  vecTipIndSize = 0;     /* capacity, in doubles */
+static int     vecTipIndLocus = -1;   /* locus the blocks currently describe */
+static double *vecRootLik = NULL;     /* root reduction, length npatt */
+static size_t  vecRootLikSize = 0;
+static double *vecRootLikRef = NULL;  /* scalar reference, vecLnL = 2 only */
+static size_t  vecRootLikRefSize = 0;
+static long    vecCmpCalls = 0;
+static double  vecCmpMaxAbs = 0.0, vecCmpMaxRel = 0.0;
+
+static void AllocVecWorkspace(void)
+{
+   /* Size the workspace for the largest locus over all genes.  GetMem() knows
+      every locus's npatt and ns, so a single pass is enough. */
+   int locus, n = com.ncode;
+   size_t ind = 0, rootlik = 0, need;
+
+   for (locus = 0; locus < data.ngene; locus++) {
+      need = (size_t)n * data.npatt[locus];
+      if (need > rootlik) rootlik = need / (n > 0 ? (size_t)n : 1);
+      need *= (size_t)data.ns[locus];
+      if (need > ind) ind = need;
+   }
+   if (ind > vecTipIndSize) {
+      free(vecTipInd);
+      vecTipInd = (double*)malloc(ind * sizeof(double));
+      if (vecTipInd == NULL) zerror("oom vecTipInd");
+      vecTipIndSize = ind;
+   }
+   if (rootlik > vecRootLikSize) {
+      free(vecRootLik);
+      vecRootLik = (double*)malloc(rootlik * sizeof(double));
+      if (vecRootLik == NULL) zerror("oom vecRootLik");
+      vecRootLikSize = rootlik;
+   }
+   if (com.vecLnL >= 2 && rootlik > vecRootLikRefSize) {
+      free(vecRootLikRef);
+      vecRootLikRef = (double*)malloc(rootlik * sizeof(double));
+      if (vecRootLikRef == NULL) zerror("oom vecRootLikRef");
+      vecRootLikRefSize = rootlik;
+   }
+   vecTipIndLocus = -1;      /* force a rebuild for the first locus seen */
+}
+
+
+static void FreeVecWorkspace(void)
+{
+   if (vecCmpCalls)
+      printf("\nvecLnL=2 verification: %ld likelihood evaluations compared,\n"
+             "  worst per-pattern abs difference %.3e\n"
+             "  worst per-pattern relative difference %.3e\n",
+             vecCmpCalls, vecCmpMaxAbs, vecCmpMaxRel);
+   free(vecTipInd);  vecTipInd = NULL;  vecTipIndSize = 0;
+   free(vecRootLik); vecRootLik = NULL; vecRootLikSize = 0;
+   free(vecRootLikRef); vecRootLikRef = NULL; vecRootLikRefSize = 0;
+   vecTipIndLocus = -1;
+   free(com.vecConPin[0]);
+   com.vecConPin[0] = com.vecConPin[1] = NULL;
+}
+
+
+static void BuildVecTipInd(int locus)
+{
+   /* Fold one locus's tips into 0/1 indicator blocks.  Called from UseLocus(),
+      so the block is rebuilt exactly when the locus changes and then reused
+      for the rest of the MCMC -- the data never changes under it. */
+   int tip, h, k, npatt = data.npatt[locus], n = com.ncode;
+   const size_t block = (size_t)n * npatt;
+   double *ind = vecTipInd;
+
+   if (vecTipInd == NULL || vecTipIndLocus == locus || npatt <= 0) return;
+
+   for (tip = 0; tip < data.ns[locus]; tip++) {
+      const char *z = data.z[locus][tip];
+      memset(ind, 0, block * sizeof(double));
+      if (data.cleandata[locus]) {                 /* z[] holds a state index */
+         for (h = 0; h < npatt; h++) {
+            const int state = (int)(unsigned char)z[h];
+            if (state >= 0 && state < n) ind[(size_t)state * npatt + h] = 1.0;
+         }
+      }
+      else {                                       /* z[] holds a code index */
+         for (h = 0; h < npatt; h++) {
+            const int code = (int)(unsigned char)z[h];
+            for (k = 0; k < nChara[code]; k++)
+               ind[(size_t)CharaMap[code][k] * npatt + h] = 1.0;
+         }
+      }
+      ind += block;
+   }
+   vecTipIndLocus = locus;
+}
+
+
+static void VecRootLik(void)
+{
+   /* Per-pattern likelihood at the root: sum_j pi[j] * vecConP[j][h].  This is
+      the same AXPY reduction pyml's own kernel applies in LogLikPruner(). */
+   int j, npatt = com.npatt;
+   const double *root = nodes[tree.root].vecConP;
+
+   pyml_vec_fill_f64(vecRootLik, 0.0, npatt);
+   for (j = 0; j < com.ncode; ++j)
+      pyml_vec_muladd_f64(vecRootLik, root + (size_t)j * npatt, com.pi[j], npatt);
+}
+
+
+/* ---- vecLnL = 2: numerical equivalence check ------------------------------
+   mcmc.txt prints lnL with three decimals, so comparing sampled traces cannot
+   resolve better than ~1e-3 on a value near -1e4.  In verification mode lfun()
+   runs BOTH implementations on the same parameters and hands the two root
+   likelihood vectors here.  Comparing the vectors directly, at full double
+   precision, tests every pattern rather than just the aggregate. */
+
+static void VecStashScalarRoot(void)
+{
+   /* Exactly the reduction lfun() would have done, kept separate. */
+   int h, i, npatt = com.npatt;
+   const double *root = nodes[tree.root].conP;
+
+   for (h = 0; h < npatt; h++) {
+      double fh = 0;
+      for (i = 0; i < com.ncode; i++)
+         fh += com.pi[i] * root[h * com.ncode + i];
+      vecRootLikRef[h] = fh;
+   }
+}
+
+
+static void VecReportRootDiff(void)
+{
+   int h, npatt = com.npatt;
+   double absmax = 0, relmax = 0;
+
+   for (h = 0; h < npatt; h++) {
+      const double a = vecRootLikRef[h], b = vecRootLik[h];
+      const double d = fabs(a - b);
+      if (d > absmax) absmax = d;
+      if (a != 0 && d / fabs(a) > relmax) relmax = d / fabs(a);
+   }
+   ++vecCmpCalls;
+   if (absmax > vecCmpMaxAbs) vecCmpMaxAbs = absmax;
+   if (relmax > vecCmpMaxRel) vecCmpMaxRel = relmax;
+   if (vecCmpCalls <= 5)
+      printf("vecLnL=2 check %6ld: npatt %6d  max abs %.3e  max rel %.3e\n",
+             vecCmpCalls, npatt, absmax, relmax);
+   else if (vecCmpCalls % 500 == 0)
+      printf("vecLnL=2 running max over %ld checks: abs %.3e  rel %.3e\n",
+             vecCmpCalls, vecCmpMaxAbs, vecCmpMaxRel);
+}
+
+
+int ConditionalPNodeVec(int inode, int igene, double x[])
+{
+   /* Same recursion and the same conP caching as ConditionalPNode(), but the
+      node blocks are state-major and the inner loops are AXPYs. */
+   int i, ison, n = com.ncode, npatt = com.npatt;
+   double t, *parent;
+
+   if (nodes[inode].nson < 1) return (0);
+
+   for (i = 0; i < nodes[inode].nson; i++) {
+      ison = nodes[inode].sons[i];
+      if (nodes[ison].nson > 0 && !com.oldconP[ison])
+         ConditionalPNodeVec(ison, igene, x);
+   }
+
+   parent = nodes[inode].vecConP;
+   for (i = 0; i < nodes[inode].nson; i++) {
+      ison = nodes[inode].sons[i];
+
+      t = nodes[ison].branch * _rateSite;
+      if (t < 0) {
+         printf("\nt =%12.6f ratesite = %.6f", nodes[ison].branch, _rateSite);
+         zerror("blength < 0");
+      }
+      GetPMatBranch2(PMat, t);
+
+      /* This child's contribution: sum_k PMat[j][k]*L[k][h].  A tip reads its
+         precomputed indicator block, an internal node its own vecConP.  The
+         kernel is one pass over the pattern axis with the k-reduction held in
+         registers -- see the note on pyml_vec_pmat_mul_f64().
+         The first child seeds the parent and the rest multiply in, which is
+         what PAML's "conP[] = 1 then *= each child" amounts to; the multiply
+         is fused into the same pass rather than costing a second sweep. */
+      {
+         const double *child = (nodes[ison].nson < 1)
+            ? vecTipInd + (size_t)ison * (size_t)n * npatt
+            : nodes[ison].vecConP;
+         if (i == 0) pyml_vec_pmat_mul_f64(parent, child, PMat, n, npatt);
+         else        pyml_vec_pmat_mul_acc_f64(parent, child, PMat, n, npatt);
+      }
+   }
+   return (0);
+}
